{
  "name": "futschool-firestore-security-tests",
  "private": true,
  "version": "1.0.0",
  "description": "Pruebas de autorización y validación exclusivamente en el emulador local.",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-futschool-admin --config ../../firebase.json \"node --test --test-concurrency=1 rules.test.cjs\"",
    "test:rules": "node --test --test-concurrency=1 rules.test.cjs",
    "grant-admin": "node ../../scripts/grant-admin.cjs"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.33.0"
  }
}
